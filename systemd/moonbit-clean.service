[Unit]
Description=MoonBit Automated Cleaning
Documentation=https://github.com/Nomadcxx/moonbit
After=network.target
# Ensure scan has run before cleaning
After=moonbit-scan.service
Conflicts=moonbit-daemon.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/var/lib/moonbit/config
Environment=XDG_CACHE_HOME=/var/cache
Environment=XDG_DATA_HOME=/var/lib
StateDirectory=moonbit
CacheDirectory=moonbit
RuntimeDirectory=moonbit
# Keep /run/moonbit/op.lock: the TUI or the panel may hold it across a stop.
RuntimeDirectoryPreserve=yes
# Run with --force to actually clean (not dry-run)
ExecStartPre=/usr/local/bin/moonbit scan --mode quick --no-prompt
ExecStart=/usr/local/bin/moonbit clean --force --mode quick
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moonbit-clean

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
# Match `sudo moonbit`: every category the TUI cleans lives under /var or a
# user's home, so only /usr, /boot and /etc stay read-only.
ProtectSystem=full

[Install]
WantedBy=multi-user.target
