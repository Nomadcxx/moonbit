[Unit]
Description=MoonBit System Cleaner Daemon
Documentation=https://github.com/Nomadcxx/moonbit
After=network.target
Conflicts=moonbit-scan.service moonbit-clean.service moonbit-scan.timer moonbit-clean.timer

[Service]
Type=simple
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/var/lib/moonbit/config
Environment=XDG_CACHE_HOME=/var/cache
Environment=XDG_DATA_HOME=/var/lib
StateDirectory=moonbit
CacheDirectory=moonbit
LogsDirectory=moonbit
ExecStart=/usr/local/bin/moonbit daemon --log /var/log/moonbit/daemon.log --pid /run/moonbit/moonbit.pid --socket /run/moonbit/panel.sock
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=30

# Security hardening (matching existing service files)
PrivateTmp=yes
NoNewPrivileges=yes
# Match `sudo moonbit`: every category the TUI cleans lives under /var or a
# user's home, so only /usr, /boot and /etc stay read-only.
ProtectSystem=full
RuntimeDirectory=moonbit
# Keep /run/moonbit/op.lock: the TUI or the panel may hold it across a stop.
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0755

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=moonbit-daemon

[Install]
WantedBy=multi-user.target
