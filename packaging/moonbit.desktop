[Desktop Entry]
Type=Application
Version=1.0
Name=moonbit
GenericName=System Cleaner
Comment=Reclaim disk space from caches, logs and temporary files
Icon=moonbit
# pkexec sanitises PATH to /usr/sbin:/usr/bin:/sbin:/bin, so /usr/local/bin is
# not searched and the path must be absolute. Packages rewrite this to
# /usr/bin/moonbit; this value is for the from-source install.
Exec=pkexec /usr/local/bin/moonbit
# moonbit is a TUI, so it needs a terminal. polkit prompts for the password
# before the TUI starts, which is the point of launching it this way.
Terminal=true
Categories=System;Filesystem;
Keywords=clean;cleaner;cache;disk;space;cleanup;maintenance;temp;
StartupNotify=false
